<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="hahhub" WindowStyle="None" ResizeMode="CanResize" Width="940" Height="690" MinWidth="790" MinHeight="625" WindowStartupLocation="CenterScreen" Background="Transparent" Foreground="#F1F2F4" FontFamily="Segoe UI Variable Text, Microsoft YaHei UI" UseLayoutRounding="True" SnapsToDevicePixels="True">
<Window.Resources>
<Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/></Style>
<LinearGradientBrush x:Key="ShellTint" StartPoint="0,0" EndPoint="1,1">
 <GradientStop Offset="0" Color="#9B27323D"/><GradientStop Offset=".58" Color="#861B242F"/><GradientStop Offset="1" Color="#9C151C26"/>
</LinearGradientBrush>
<LinearGradientBrush x:Key="PaneFill" StartPoint="0,0" EndPoint="1,1">
 <GradientStop Offset="0" Color="#9B384451"/><GradientStop Offset="1" Color="#84303945"/>
</LinearGradientBrush>
<SolidColorBrush x:Key="PaneEdge" Color="#427F92A7"/>
<Style TargetType="Button">
 <Setter Property="Background" Value="#9935414E"/><Setter Property="Foreground" Value="#F1F5FA"/>
 <Setter Property="Padding" Value="15,8"/><Setter Property="Cursor" Value="Hand"/><Setter Property="BorderBrush" Value="#536F8297"/><Setter Property="BorderThickness" Value="1"/>
 <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
  <Border x:Name="bg" CornerRadius="7" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
   <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
  </Border>
  <ControlTemplate.Triggers>
   <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bg" Property="BorderBrush" Value="#A5BBD2"/></Trigger>
   <Trigger Property="IsPressed" Value="True"><Setter TargetName="bg" Property="Opacity" Value=".76"/></Trigger>
   <Trigger Property="IsEnabled" Value="False"><Setter TargetName="bg" Property="Opacity" Value=".46"/></Trigger>
   <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="bg" Property="BorderBrush" Value="#BBD8F2"/></Trigger>
  </ControlTemplate.Triggers>
 </ControlTemplate></Setter.Value></Setter>
</Style>
<Style x:Key="CaptionButton" TargetType="Button">
 <Setter Property="Width" Value="44"/><Setter Property="Height" Value="30"/><Setter Property="Foreground" Value="#CFDCE8"/>
 <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
 <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
  <Border x:Name="Hit" Background="{TemplateBinding Background}" CornerRadius="5" BorderThickness="1" BorderBrush="Transparent">
   <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
  </Border>
  <ControlTemplate.Triggers>
   <Trigger Property="IsPressed" Value="True"><Setter TargetName="Hit" Property="Background" Value="#557F95A9"/></Trigger>
   <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Hit" Property="BorderBrush" Value="#ADD1EC"/></Trigger>
  </ControlTemplate.Triggers>
 </ControlTemplate></Setter.Value></Setter>
 <Style.Triggers>
  <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#366F849B"/></Trigger>
  <Trigger Property="Tag" Value="Hot"><Setter Property="Background" Value="#366F849B"/></Trigger>
 </Style.Triggers>
</Style>
<Style x:Key="SliderTrackPart" TargetType="RepeatButton">
 <Setter Property="Focusable" Value="False"/><Setter Property="Template"><Setter.Value>
 <ControlTemplate TargetType="RepeatButton"><Grid Background="Transparent"><Border Height="3" CornerRadius="1.5" Background="{TemplateBinding Background}"/></Grid></ControlTemplate>
 </Setter.Value></Setter>
</Style>
<Style TargetType="Slider">
 <Setter Property="Height" Value="23"/><Setter Property="Margin" Value="0,2,0,6"/><Setter Property="IsSnapToTickEnabled" Value="True"/><Setter Property="IsMoveToPointEnabled" Value="True"/>
 <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider">
  <Grid Background="Transparent"><Track x:Name="PART_Track">
   <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource SliderTrackPart}" Command="Slider.DecreaseLarge" Background="#ACC9E2"/></Track.DecreaseRepeatButton>
   <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource SliderTrackPart}" Command="Slider.IncreaseLarge" Background="#596676"/></Track.IncreaseRepeatButton>
   <Track.Thumb><Thumb Width="15" Cursor="Hand"><Thumb.Template><ControlTemplate TargetType="Thumb"><Grid Background="Transparent">
    <Ellipse Height="13" Width="13" Fill="#E1EDF6" Stroke="#A8BDD0"/><Ellipse x:Name="Core" Height="5" Width="5" Fill="#6889A8"/>
   </Grid><ControlTemplate.Triggers><Trigger Property="IsDragging" Value="True"><Setter TargetName="Core" Property="Fill" Value="#2D4C67"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
  </Track></Grid>
 </ControlTemplate></Setter.Value></Setter>
</Style>
<Style x:Key="CrackChoice" TargetType="RadioButton">
 <Setter Property="Cursor" Value="Hand"/><Setter Property="Padding" Value="13,4"/><Setter Property="Foreground" Value="#B8C1CE"/>
 <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
 <Border x:Name="Plate" CornerRadius="5" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center"/></Border>
 <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Plate" Property="Background" Value="#66394756"/></Trigger>
 <Trigger Property="IsChecked" Value="True"><Setter TargetName="Plate" Property="Background" Value="#8B465A6F"/><Setter Property="Foreground" Value="#F6F8FB"/></Trigger>
 <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Plate" Property="BorderBrush" Value="#CBD6E5"/></Trigger></ControlTemplate.Triggers>
 </ControlTemplate></Setter.Value></Setter></Style>
<Style x:Key="NavigationItem" TargetType="RadioButton" BasedOn="{StaticResource CrackChoice}">
 <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
  <Grid><Border x:Name="Plate" CornerRadius="7" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" Padding="{TemplateBinding Padding}">
   <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
  </Border><Border x:Name="Marker" HorizontalAlignment="Left" VerticalAlignment="Center" Width="3" Height="17" CornerRadius="1.5" Background="#AACCE8" Visibility="Hidden"/></Grid>
  <ControlTemplate.Triggers>
   <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Plate" Property="Background" Value="#503E5165"/></Trigger>
   <Trigger Property="IsChecked" Value="True"><Setter TargetName="Plate" Property="Background" Value="#88405469"/><Setter TargetName="Plate" Property="BorderBrush" Value="#346B8298"/><Setter TargetName="Marker" Property="Visibility" Value="Visible"/><Setter Property="Foreground" Value="#EDF5FF"/></Trigger>
   <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Plate" Property="BorderBrush" Value="#ACCBE6"/></Trigger>
  </ControlTemplate.Triggers>
 </ControlTemplate></Setter.Value></Setter>
</Style>
<Style TargetType="RadioButton"><Setter Property="Foreground" Value="#EAECF0"/><Setter Property="Margin" Value="0,8,14,0"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Cursor" Value="Hand"/></Style>
</Window.Resources>
<Grid><Grid x:Name="ShellContent"><Grid.ColumnDefinitions><ColumnDefinition Width="176"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Border x:Name="Backdrop" Grid.ColumnSpan="2" Background="{StaticResource ShellTint}" IsHitTestVisible="False"/>
<Border Background="#79141C25" BorderBrush="#375A6B7E" BorderThickness="0,0,1,0"><DockPanel Margin="17,17,14,22">
<StackPanel DockPanel.Dock="Top"><StackPanel Orientation="Horizontal"><Border Width="30" Height="30" Background="#D9DDE5" CornerRadius="8"><Path Stroke="#272A30" StrokeThickness="2.6" Data="M 8,8 L 8,22 M 21,8 L 21,22 M 8,18 L 21,12"/></Border><TextBlock Text="hahhub" Margin="9,0,0,0" FontSize="18" FontWeight="SemiBold"/></StackPanel>
<TextBlock Text="{DynamicResource 'Effects'}" Foreground="#B1BDCB" FontSize="12" Margin="0,24,0,6"/>
<Border Background="#60141E28" CornerRadius="6" Padding="2" Margin="0,0,0,8"><UniformGrid x:Name="CategoryTabs" Rows="2" Columns="2">
<RadioButton x:Name="MaterialsTab" Tag="MaterialsTiles" GroupName="Category" Style="{StaticResource CrackChoice}" Padding="3,4" Content="{DynamicResource 'Materials'}"/>
<RadioButton x:Name="WeatherTab" Tag="WeatherTiles" GroupName="Category" Style="{StaticResource CrackChoice}" Padding="3,4" Content="{DynamicResource 'Weather'}"/>
<RadioButton x:Name="CreaturesTab" Tag="CreaturesTiles" GroupName="Category" Style="{StaticResource CrackChoice}" Padding="3,4" Content="{DynamicResource 'Creatures'}"/>
<RadioButton x:Name="EnergyTab" Tag="EnergyTiles" GroupName="Category" Style="{StaticResource CrackChoice}" Padding="3,4" Content="{DynamicResource 'Energy'}"/>
</UniformGrid></Border>
</StackPanel>
<StackPanel DockPanel.Dock="Bottom"><Button x:Name="Community" Content="{DynamicResource 'Lively Community  ↗'}" FontSize="12" Padding="7,7"/><Border Height="1" Background="#373A40" Margin="0,17,0,12"/>
<Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
<StackPanel><TextBlock Text="{DynamicResource 'Developer'}" Foreground="#B1BDCB" FontSize="11"/><TextBlock Text="HAHHAN" Margin="0,3,0,0" FontWeight="SemiBold"/></StackPanel>
<Button x:Name="Settings" Grid.Column="1" Content="{DynamicResource 'Settings'}" Padding="8,4" FontSize="12" VerticalAlignment="Center"/>
</Grid>
<TextBlock Margin="0,7,0,0" FontSize="12"><Hyperlink x:Name="ProjectLink" NavigateUri="https://github.com/dotohua009/Hahhub-lively" ToolTip="dotohua009/Hahhub-lively" Foreground="#BCCDE5" AutomationProperties.Name="{DynamicResource 'GitHub'}">GitHub ↗</Hyperlink></TextBlock>
</StackPanel><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel><StackPanel x:Name="MaterialsTiles" Visibility="Collapsed">
<RadioButton x:Name="GlitterTile" Style="{StaticResource NavigationItem}" GroupName="Effect" Padding="8,6" Margin="0,3,0,0" AutomationProperties.Name="{DynamicResource 'Glitter Flow'}"><StackPanel Orientation="Horizontal" Width="112"><Image x:Name="GlitterImage" Width="34" Height="30" Stretch="UniformToFill"/><TextBlock Text="{DynamicResource 'Glitter Flow'}" FontWeight="SemiBold" Margin="10,0,0,0"/></StackPanel></RadioButton>
<RadioButton x:Name="GlassTile" Style="{StaticResource NavigationItem}" GroupName="Effect" HorizontalContentAlignment="Left" Padding="8,6" AutomationProperties.Name="{DynamicResource 'Fracture'}"><StackPanel Orientation="Horizontal" Width="112"><Image x:Name="Tile" Width="34" Height="30" Stretch="UniformToFill"/><TextBlock Text="{DynamicResource 'Fracture'}" FontWeight="SemiBold" Margin="10,0,0,0"/></StackPanel></RadioButton>
<RadioButton x:Name="InkTile" Style="{StaticResource NavigationItem}" GroupName="Effect" Padding="8,6" Margin="0,3,0,0" AutomationProperties.Name="{DynamicResource 'Ink Splash'}"><StackPanel Orientation="Horizontal" Width="112"><Image x:Name="InkImage" Width="34" Height="30" Stretch="UniformToFill"/><TextBlock Text="{DynamicResource 'Ink Splash'}" FontWeight="SemiBold" Margin="10,0,0,0"/></StackPanel></RadioButton>
<RadioButton x:Name="PrismTile" Style="{StaticResource NavigationItem}" GroupName="Effect" Padding="8,6" Margin="0,3,0,0" AutomationProperties.Name="{DynamicResource 'Prism'}"><StackPanel Orientation="Horizontal" Width="112"><Image x:Name="PrismImage" Width="34" Height="30" Stretch="UniformToFill"/><TextBlock Text="{DynamicResource 'Prism'}" FontWeight="SemiBold" Margin="10,0,0,0"/></StackPanel></RadioButton>
</StackPanel>
<StackPanel x:Name="WeatherTiles" Visibility="Collapsed">
<RadioButton x:Name="FogTile" Style="{StaticResource NavigationItem}" GroupName="Effect" Padding="8,6" Margin="0,3,0,0" AutomationProperties.Name="{DynamicResource 'Frost Fog'}"><StackPanel Orientation="Horizontal" Width="112"><Image x:Name="FogImage" Width="34" Height="30" Stretch="UniformToFill"/><TextBlock Text="{DynamicResource 'Frost Fog'}" FontWeight="SemiBold" Margin="10,0,0,0"/></StackPanel></RadioButton>
<RadioButton x:Name="SnowTile" Style="{StaticResource NavigationItem}" GroupName="Effect" Padding="8,6" Margin="0,3,0,0" AutomationProperties.Name="{DynamicResource 'Snowdrift'}"><StackPanel Orientation="Horizontal" Width="112"><Image x:Name="SnowImage" Width="34" Height="30" Stretch="UniformToFill"/><TextBlock Text="{DynamicResource 'Snowdrift'}" FontWeight="SemiBold" Margin="10,0,0,0"/></StackPanel></RadioButton>
<RadioButton x:Name="FrostTile" Style="{StaticResource NavigationItem}" GroupName="Effect" Padding="8,6" Margin="0,3,0,0" AutomationProperties.Name="{DynamicResource 'Frost Lance'}"><StackPanel Orientation="Horizontal" Width="112"><Image x:Name="FrostImage" Width="34" Height="30" Stretch="UniformToFill"/><TextBlock Text="{DynamicResource 'Frost Lance'}" FontWeight="SemiBold" Margin="10,0,0,0"/></StackPanel></RadioButton>
</StackPanel>
<StackPanel x:Name="CreaturesTiles" Visibility="Collapsed">
<RadioButton x:Name="TendrilTile" Style="{StaticResource NavigationItem}" GroupName="Effect" Padding="8,6" Margin="0,3,0,0" AutomationProperties.Name="{DynamicResource 'Tendrils'}"><StackPanel Orientation="Horizontal" Width="112"><Image x:Name="TendrilImage" Width="34" Height="30" Stretch="UniformToFill"/><TextBlock Text="{DynamicResource 'Tendrils'}" FontWeight="SemiBold" Margin="10,0,0,0"/></StackPanel></RadioButton>
<RadioButton x:Name="SilkTile" Style="{StaticResource NavigationItem}" GroupName="Effect" Padding="8,6" Margin="0,3,0,0" AutomationProperties.Name="{DynamicResource 'Silk Colony'}"><StackPanel Orientation="Horizontal" Width="112"><Image x:Name="SilkImage" Width="34" Height="30" Stretch="UniformToFill"/><TextBlock Text="{DynamicResource 'Silk Colony'}" FontWeight="SemiBold" Margin="10,0,0,0"/></StackPanel></RadioButton>
</StackPanel>
<StackPanel x:Name="EnergyTiles" Visibility="Collapsed">
<RadioButton x:Name="HoleTile" Style="{StaticResource NavigationItem}" GroupName="Effect" Padding="8,6" Margin="0,3,0,0" AutomationProperties.Name="{DynamicResource 'Black Hole'}"><StackPanel Orientation="Horizontal" Width="112"><Image x:Name="HoleImage" Width="34" Height="30" Stretch="UniformToFill"/><TextBlock Text="{DynamicResource 'Black Hole'}" FontWeight="SemiBold" Margin="10,0,0,0"/></StackPanel></RadioButton>
<RadioButton x:Name="FuseTile" Style="{StaticResource NavigationItem}" GroupName="Effect" Padding="8,6" Margin="0,3,0,0" AutomationProperties.Name="{DynamicResource 'Voxel Fuse'}"><StackPanel Orientation="Horizontal" Width="112"><Image x:Name="FuseImage" Width="34" Height="30" Stretch="UniformToFill"/><TextBlock Text="{DynamicResource 'Voxel Fuse'}" FontWeight="SemiBold" Margin="10,0,0,0"/></StackPanel></RadioButton>
</StackPanel>
<Border Height="1" Background="#373A40" Margin="0,12,0,9"/>
<RadioButton x:Name="VideoTile" Style="{StaticResource NavigationItem}" GroupName="Effect" Padding="8,7" AutomationProperties.Name="{DynamicResource 'Video Cast'}"><StackPanel Orientation="Horizontal" Width="112"><Grid Width="34" Height="28"><Path Data="M3,5 H29 V22 H3 Z M11,25 H21" Stroke="#B8C8DE" StrokeThickness="1.5"/><Path Data="M13,9 L20,13.5 L13,18 Z" Fill="#D9E5F3"/></Grid><TextBlock Text="{DynamicResource 'Video Cast'}" FontWeight="SemiBold" Margin="10,0,0,0"/></StackPanel></RadioButton></StackPanel></ScrollViewer></DockPanel></Border>
<Grid x:Name="EffectView" Grid.Column="1" Margin="26,45,26,18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="*"/><RowDefinition Height="14"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Grid><StackPanel><TextBlock x:Name="EffectTitle" Text="{DynamicResource 'Fracture'}" FontSize="31" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource 'IPI 84   /   Keyboard effects'}" Margin="1,4,0,0" Foreground="#B2B6BE" FontSize="13"/></StackPanel>
<StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" MaxWidth="330"><StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
<ToggleButton x:Name="CursorBoundary" Visibility="Collapsed" Width="35" Height="30" Margin="0,0,7,0" Cursor="Hand" Focusable="True" AutomationProperties.Name="{DynamicResource 'Block pointer entry'}">
<ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
<Border x:Name="Frame" CornerRadius="7" BorderThickness="1" BorderBrush="#6B8192" Background="#343D48">
<Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="21" Height="22">
<Path Data="M3,4 L4,18 7.5,14.5 10,20 13,18.5 10.5,13 15.5,12.5 Z" Fill="#DDE8F1"/>
<Path x:Name="Gate" Data="M18.5,3 V18" Stroke="#7D8994" StrokeThickness="2" StrokeDashArray="1.5 1.2"/></Grid></Border>
<ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Frame" Property="Background" Value="#394F62"/><Setter TargetName="Frame" Property="BorderBrush" Value="#849FB4"/><Setter TargetName="Gate" Property="Stroke" Value="#C5E5FF"/><Setter TargetName="Gate" Property="StrokeDashArray" Value="1 0"/></Trigger>
<Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#CEE5FA"/></Trigger>
<Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="White"/></Trigger>
</ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template></ToggleButton><Button x:Name="Target" Content="{DynamicResource 'Select display  ▾'}" Padding="12,6" AutomationProperties.Name="{DynamicResource 'Select display'}"/></StackPanel><TextBlock x:Name="DisplayState" HorizontalAlignment="Right" FontSize="11" Foreground="#B2B6BE" Margin="0,4,2,0"/></StackPanel></Grid>
<Border Grid.Row="2" CornerRadius="12" BorderBrush="{StaticResource PaneEdge}" BorderThickness="1" Background="#21242A" ClipToBounds="True"><Grid x:Name="Hero" Background="Transparent" ClipToBounds="True" Cursor="Hand" Focusable="True" AutomationProperties.Name="{DynamicResource 'Effect preview. Click or press a key.'}">
<Viewbox Stretch="Uniform" IsHitTestVisible="False"><Canvas x:Name="BoardPlane" Width="2020" Height="790"><Image x:Name="Cover" Stretch="Fill"/><Image x:Name="LivePreview" Width="1920" Height="720" Stretch="Fill"/></Canvas></Viewbox>
<Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Background="#C4212933" CornerRadius="6" Padding="10,5" Margin="13"><TextBlock Text="{DynamicResource 'Click or press a key'}" FontSize="12" Foreground="#E9EBEF"/></Border></Grid></Border>
<Grid Grid.Row="4"><Grid.ColumnDefinitions><ColumnDefinition Width="1.3*"/><ColumnDefinition Width="13"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
<Border Background="{StaticResource PaneFill}" BorderBrush="{StaticResource PaneEdge}" BorderThickness="1" Padding="15,12,15,6" CornerRadius="11"><StackPanel><StackPanel x:Name="GlassPanel"><DockPanel Margin="0,0,0,9"><Border DockPanel.Dock="Right" Background="#60141E28" CornerRadius="6" Padding="2"><StackPanel Orientation="Horizontal">
 <RadioButton x:Name="LargeCracks" Style="{StaticResource CrackChoice}" GroupName="CrackSize" Content="{DynamicResource 'Wide'}"/>
 <RadioButton x:Name="SmallCracks" Style="{StaticResource CrackChoice}" GroupName="CrackSize" Content="{DynamicResource 'Fine'}"/>
 </StackPanel></Border><TextBlock Text="{DynamicResource 'Cracks'}" FontSize="16" FontWeight="SemiBold"/></DockPanel>
<DockPanel><TextBlock x:Name="DensityNum" DockPanel.Dock="Right" Foreground="#D8DDE6"/><TextBlock Text="{DynamicResource 'Density'}"/></DockPanel><Slider x:Name="Density" Minimum="30" Maximum="100" TickFrequency="1" AutomationProperties.Name="{DynamicResource 'Density'}"/>
<DockPanel><TextBlock x:Name="SpreadNum" DockPanel.Dock="Right" Foreground="#D8DDE6"/><TextBlock Text="{DynamicResource 'Spread'}"/></DockPanel><Slider x:Name="Spread" Minimum="45" Maximum="150" TickFrequency="1" AutomationProperties.Name="{DynamicResource 'Spread'}"/>
<DockPanel><TextBlock x:Name="DelayNum" DockPanel.Dock="Right" Foreground="#D8DDE6"/><TextBlock Text="{DynamicResource 'Heal delay'}"/></DockPanel><Slider x:Name="Delay" Minimum="0" Maximum="5000" TickFrequency="100" AutomationProperties.Name="{DynamicResource 'Heal delay'}"/>
<DockPanel><TextBlock x:Name="HealNum" DockPanel.Dock="Right" Foreground="#D8DDE6"/><TextBlock Text="{DynamicResource 'Heal duration'}"/></DockPanel><Slider x:Name="Heal" Minimum="500" Maximum="4000" TickFrequency="50" AutomationProperties.Name="{DynamicResource 'Heal duration'}"/>
</StackPanel>
<StackPanel x:Name="HolePanel" Visibility="Collapsed"><TextBlock Text="{DynamicResource 'Gravity'}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,13"/>
<DockPanel><TextBlock x:Name="PullNum" DockPanel.Dock="Right" Foreground="#D8DDE6"/><TextBlock Text="{DynamicResource 'Pull strength'}"/></DockPanel>
<Slider x:Name="Pull" Minimum="20" Maximum="100" TickFrequency="1" AutomationProperties.Name="{DynamicResource 'Pull strength'}"/>
<TextBlock Text="{DynamicResource 'Hold for 4.7 s to fill the display. Nearby holes merge. Release to let them shrink.'}" TextWrapping="Wrap" Foreground="#B5B9C1" Margin="0,10,0,0"/>
</StackPanel>
<StackPanel x:Name="InkPanel" Visibility="Collapsed"><TextBlock Text="{DynamicResource 'Ink Splash'}" FontSize="16" FontWeight="SemiBold"/><DockPanel Margin="0,5,0,0"><TextBlock x:Name="SprayNum" DockPanel.Dock="Right" Foreground="#C4D6E7"/><TextBlock Text="{DynamicResource 'Spray range'}"/></DockPanel><Slider x:Name="Spray" Minimum="75" Maximum="250" TickFrequency="5" SmallChange="5" AutomationProperties.Name="{DynamicResource 'Spray range'}"/><DockPanel Margin="0,5,0,0"><TextBlock x:Name="DryNum" DockPanel.Dock="Right" Foreground="#C4D6E7"/><TextBlock Text="{DynamicResource 'Recovery time'}"/></DockPanel><Slider x:Name="Dry" Minimum="500" Maximum="6000" TickFrequency="100" SmallChange="100" AutomationProperties.Name="{DynamicResource 'Recovery time'}"/></StackPanel>
<StackPanel x:Name="FusePanel" Visibility="Collapsed">
<DockPanel Margin="0,0,0,4"><TextBlock x:Name="FuseDurationValue" DockPanel.Dock="Right" Foreground="#D8DDE6"/><TextBlock Text="{DynamicResource 'Fuse delay'}"/></DockPanel>
<Slider x:Name="FuseDuration" Minimum="150" Maximum="5000" TickFrequency="50" SmallChange="50" LargeChange="250" IsSnapToTickEnabled="True" AutomationProperties.Name="{DynamicResource 'Fuse delay'}"/>
</StackPanel>
<StackPanel x:Name="WeatherPanel" Visibility="Collapsed">
<DockPanel><TextBlock x:Name="WeatherDensityValue" DockPanel.Dock="Right" Foreground="#D8DDE6"/><TextBlock Text="{DynamicResource 'Particle density'}"/></DockPanel>
<Slider x:Name="WeatherDensity" Minimum="30" Maximum="160" Value="100" TickFrequency="5" SmallChange="5" IsSnapToTickEnabled="True" AutomationProperties.Name="{DynamicResource 'Particle density'}"/>
<DockPanel><TextBlock x:Name="WeatherSpreadValue" DockPanel.Dock="Right" Foreground="#D8DDE6"/><TextBlock Text="{DynamicResource 'Spread'}"/></DockPanel>
<Slider x:Name="WeatherSpread" Minimum="50" Maximum="180" Value="100" TickFrequency="5" SmallChange="5" IsSnapToTickEnabled="True" AutomationProperties.Name="{DynamicResource 'Spread'}"/>
<DockPanel><TextBlock x:Name="WeatherClearValue" DockPanel.Dock="Right" Foreground="#D8DDE6"/><TextBlock Text="{DynamicResource 'Dissipation'}"/></DockPanel>
<Slider x:Name="WeatherClear" Minimum="400" Maximum="4500" Value="1800" TickFrequency="50" SmallChange="50" IsSnapToTickEnabled="True" AutomationProperties.Name="{DynamicResource 'Dissipation'}"/>
</StackPanel>
<StackPanel x:Name="SkillPanel" Visibility="Collapsed"><TextBlock x:Name="SkillHint" TextWrapping="Wrap" Foreground="#CCD6E2" Margin="0,2,0,8"/></StackPanel>
<CheckBox x:Name="Enhanced" Content="{DynamicResource 'Enhanced preset'}" Foreground="#D3DAE4" Margin="0,7,0,4"/>
<CheckBox x:Name="Spectrum" Content="{DynamicResource 'Rainbow colors'}" Foreground="#D3DAE4" Margin="0,4,0,4"/>
<Grid x:Name="RimRow" Margin="0,8,0,4"><TextBlock x:Name="PigmentCaption" Text="{DynamicResource 'Edge glow'}" VerticalAlignment="Center"/><Button x:Name="ChooseRim" HorizontalAlignment="Right" Padding="8,3" AutomationProperties.Name="{DynamicResource 'Choose edge glow color'}"><StackPanel Orientation="Horizontal"><Border x:Name="RimSwatch" Width="15" Height="15" CornerRadius="7.5" BorderThickness="1" BorderBrush="#AFFFFFFF"/><TextBlock x:Name="RimHex" Margin="7,0,0,0" FontSize="12"/></StackPanel></Button></Grid>
</StackPanel></Border>
<Border Grid.Column="2" Background="{StaticResource PaneFill}" BorderBrush="{StaticResource PaneEdge}" BorderThickness="1" Padding="15,12" CornerRadius="11"><StackPanel><TextBlock Text="{DynamicResource 'Performance'}" FontSize="16" FontWeight="SemiBold"/><TextBlock x:Name="Rate" Margin="0,10,0,1" FontSize="23" Foreground="#D9DDE6" FontWeight="Light"/>
