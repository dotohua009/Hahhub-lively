<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="hahhub" Width="940" Height="690" MinWidth="790" MinHeight="625" WindowStartupLocation="CenterScreen" Background="Transparent" Foreground="#F1F2F4" FontFamily="Segoe UI Variable Text, Microsoft YaHei UI" UseLayoutRounding="True" SnapsToDevicePixels="True">
<Window.Resources>
<Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/></Style>
<Style TargetType="Button"><Setter Property="Background" Value="#383B41"/><Setter Property="Foreground" Value="#EFF0F2"/><Setter Property="Padding" Value="15,8"/><Setter Property="Cursor" Value="Hand"/><Setter Property="BorderBrush" Value="#54585F"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="bg" CornerRadius="7" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bg" Property="Opacity" Value=".82"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="bg" Property="Opacity" Value=".46"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="bg" Property="BorderBrush" Value="White"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
<Style TargetType="Slider"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="0,5,0,8"/><Setter Property="IsSnapToTickEnabled" Value="True"/><Setter Property="IsMoveToPointEnabled" Value="True"/><Setter Property="Foreground" Value="#CCD2DD"/></Style>
<Style x:Key="CrackChoice" TargetType="RadioButton">
 <Setter Property="Cursor" Value="Hand"/><Setter Property="Padding" Value="13,4"/><Setter Property="Foreground" Value="#B8C1CE"/>
 <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
 <Border x:Name="Plate" CornerRadius="5" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center"/></Border>
 <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Plate" Property="Background" Value="#38404B"/></Trigger>
 <Trigger Property="IsChecked" Value="True"><Setter TargetName="Plate" Property="Background" Value="#46515F"/><Setter Property="Foreground" Value="#F6F8FB"/></Trigger>
 <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Plate" Property="BorderBrush" Value="#CBD6E5"/></Trigger></ControlTemplate.Triggers>
 </ControlTemplate></Setter.Value></Setter></Style>
<Style TargetType="RadioButton"><Setter Property="Foreground" Value="#EAECF0"/><Setter Property="Margin" Value="0,8,14,0"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Cursor" Value="Hand"/></Style>
</Window.Resources>
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="174"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Grid Grid.ColumnSpan="2" IsHitTestVisible="False"><Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="138"/></Grid.ColumnDefinitions>
<Border Background="#F01C1E22"/><Border Grid.Column="1" Background="#1821262C"/><Border Grid.Row="1" Grid.ColumnSpan="2" Background="#F01C1E22"/></Grid>
<Border Background="#A015171B" BorderBrush="#405F636B" BorderThickness="0,0,1,0"><DockPanel Margin="17,17,14,22">
<StackPanel DockPanel.Dock="Top"><StackPanel Orientation="Horizontal"><Border Width="30" Height="30" Background="#D9DDE5" CornerRadius="8"><Path Stroke="#272A30" StrokeThickness="2.6" Data="M 8,8 L 8,22 M 21,8 L 21,22 M 8,18 L 21,12"/></Border><TextBlock Text="hahhub" Margin="9,0,0,0" FontSize="18" FontWeight="SemiBold"/></StackPanel>
<TextBlock Text="{DynamicResource 'Effects'}" Foreground="#A2A6AE" FontSize="12" Margin="0,40,0,11"/>
<RadioButton x:Name="GlassTile" Style="{StaticResource CrackChoice}" GroupName="Effect" HorizontalContentAlignment="Left" Padding="8,6" AutomationProperties.Name="{DynamicResource 'Fracture'}"><StackPanel Orientation="Horizontal" Width="112"><Image x:Name="Tile" Width="34" Height="30" Stretch="UniformToFill"/><TextBlock Text="{DynamicResource 'Fracture'}" FontWeight="SemiBold" Margin="10,0,0,0"/></StackPanel></RadioButton>
<RadioButton x:Name="HoleTile" Style="{StaticResource CrackChoice}" GroupName="Effect" Padding="8,6" Margin="0,3,0,0" AutomationProperties.Name="{DynamicResource 'Black Hole'}"><StackPanel Orientation="Horizontal" Width="112"><Image x:Name="HoleImage" Width="34" Height="30" Stretch="UniformToFill"/><TextBlock Text="{DynamicResource 'Black Hole'}" FontWeight="SemiBold" Margin="10,0,0,0"/></StackPanel></RadioButton>
<Border Height="1" Background="#373A40" Margin="0,12,0,9"/>
<RadioButton x:Name="VideoTile" Style="{StaticResource CrackChoice}" GroupName="Effect" Padding="8,7" AutomationProperties.Name="{DynamicResource 'Video Cast'}"><StackPanel Orientation="Horizontal" Width="112"><Grid Width="34" Height="28"><Path Data="M3,5 H29 V22 H3 Z M11,25 H21" Stroke="#B8C8DE" StrokeThickness="1.5"/><Path Data="M13,9 L20,13.5 L13,18 Z" Fill="#D9E5F3"/></Grid><TextBlock Text="{DynamicResource 'Video Cast'}" FontWeight="SemiBold" Margin="10,0,0,0"/></StackPanel></RadioButton></StackPanel>
<StackPanel DockPanel.Dock="Bottom"><Button x:Name="Community" Content="{DynamicResource 'Lively Community  ↗'}" FontSize="12" Padding="7,7"/><Border Height="1" Background="#373A40" Margin="0,17,0,12"/>
<Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
<StackPanel><TextBlock Text="{DynamicResource 'Developer'}" Foreground="#A2A6AE" FontSize="11"/><TextBlock Text="HAHHAN" Margin="0,3,0,0" FontWeight="SemiBold"/></StackPanel>
<Button x:Name="Settings" Grid.Column="1" Content="{DynamicResource 'Settings'}" Padding="8,4" FontSize="12" VerticalAlignment="Center"/>
</Grid>
<TextBlock Margin="0,7,0,0" FontSize="12"><Hyperlink x:Name="ProjectLink" NavigateUri="https://github.com/dotohua009/keybloom-lively" ToolTip="dotohua009/keybloom-lively" Foreground="#BCCDE5" AutomationProperties.Name="{DynamicResource 'GitHub'}">GitHub ↗</Hyperlink></TextBlock>
</StackPanel><Grid/></DockPanel></Border>
<Grid x:Name="EffectView" Grid.Column="1" Margin="26,35,26,16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="*"/><RowDefinition Height="14"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Grid><StackPanel><TextBlock x:Name="EffectTitle" Text="{DynamicResource 'Fracture'}" FontSize="31" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource 'IPI 84   /   Keyboard effects'}" Margin="1,4,0,0" Foreground="#B2B6BE" FontSize="13"/></StackPanel>
<StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" MaxWidth="330"><Button x:Name="Target" Content="{DynamicResource 'Select display  ▾'}" Padding="12,6" AutomationProperties.Name="{DynamicResource 'Select display'}"/><TextBlock x:Name="DisplayState" HorizontalAlignment="Right" FontSize="11" Foreground="#B2B6BE" Margin="0,4,2,0"/></StackPanel></Grid>
<Border Grid.Row="2" CornerRadius="12" BorderBrush="#595F68" BorderThickness="1" Background="#21242A" ClipToBounds="True"><Grid x:Name="Hero" Background="Transparent" ClipToBounds="True" Cursor="Hand" Focusable="True" AutomationProperties.Name="{DynamicResource 'Effect preview. Click or press a key.'}">
<Image x:Name="Cover" Stretch="Fill" IsHitTestVisible="False"/><Image x:Name="LivePreview" Stretch="Fill" IsHitTestVisible="False"/>
<Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Background="#DA22252A" CornerRadius="6" Padding="10,5" Margin="13"><TextBlock Text="{DynamicResource 'Click or press a key'}" FontSize="12" Foreground="#E9EBEF"/></Border></Grid></Border>
<Grid Grid.Row="4"><Grid.ColumnDefinitions><ColumnDefinition Width="1.3*"/><ColumnDefinition Width="13"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
<Border x:Name="GlassPanel" Background="#D932353B" BorderBrush="#50545C" BorderThickness="1" Padding="15,12,15,6" CornerRadius="11"><StackPanel><DockPanel Margin="0,0,0,9"><Border DockPanel.Dock="Right" Background="#272B32" CornerRadius="6" Padding="2"><StackPanel Orientation="Horizontal">
 <RadioButton x:Name="LargeCracks" Style="{StaticResource CrackChoice}" GroupName="CrackSize" Content="{DynamicResource 'Wide'}"/>
 <RadioButton x:Name="SmallCracks" Style="{StaticResource CrackChoice}" GroupName="CrackSize" Content="{DynamicResource 'Fine'}"/>
 </StackPanel></Border><TextBlock Text="{DynamicResource 'Cracks'}" FontSize="16" FontWeight="SemiBold"/></DockPanel>
<DockPanel><TextBlock x:Name="DensityNum" DockPanel.Dock="Right" Foreground="#D8DDE6"/><TextBlock Text="{DynamicResource 'Density'}"/></DockPanel><Slider x:Name="Density" Minimum="30" Maximum="100" TickFrequency="1" AutomationProperties.Name="{DynamicResource 'Density'}"/>
<DockPanel><TextBlock x:Name="SpreadNum" DockPanel.Dock="Right" Foreground="#D8DDE6"/><TextBlock Text="{DynamicResource 'Spread'}"/></DockPanel><Slider x:Name="Spread" Minimum="45" Maximum="150" TickFrequency="1" AutomationProperties.Name="{DynamicResource 'Spread'}"/>
<DockPanel><TextBlock x:Name="DelayNum" DockPanel.Dock="Right" Foreground="#D8DDE6"/><TextBlock Text="{DynamicResource 'Heal delay'}"/></DockPanel><Slider x:Name="Delay" Minimum="0" Maximum="5000" TickFrequency="100" AutomationProperties.Name="{DynamicResource 'Heal delay'}"/>
<DockPanel><TextBlock x:Name="HealNum" DockPanel.Dock="Right" Foreground="#D8DDE6"/><TextBlock Text="{DynamicResource 'Heal duration'}"/></DockPanel><Slider x:Name="Heal" Minimum="500" Maximum="4000" TickFrequency="50" AutomationProperties.Name="{DynamicResource 'Heal duration'}"/>
</StackPanel></Border>
<Border x:Name="HolePanel" Visibility="Collapsed" Background="#D932353B" BorderBrush="#50545C" BorderThickness="1" Padding="15,13" CornerRadius="11"><StackPanel><TextBlock Text="{DynamicResource 'Gravity'}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,13"/>
<DockPanel><TextBlock x:Name="PullNum" DockPanel.Dock="Right" Foreground="#D8DDE6"/><TextBlock Text="{DynamicResource 'Pull strength'}"/></DockPanel>
<Slider x:Name="Pull" Minimum="20" Maximum="100" TickFrequency="1" AutomationProperties.Name="{DynamicResource 'Pull strength'}"/>
<TextBlock Text="{DynamicResource 'Hold for 4.7 s to fill the display. Nearby holes merge. Release to let them shrink.'}" TextWrapping="Wrap" Foreground="#B5B9C1" Margin="0,10,0,0"/>
</StackPanel></Border>
<Border Grid.Column="2" Background="#C12E3137" BorderBrush="#4B4F57" BorderThickness="1" Padding="15,12" CornerRadius="11"><StackPanel><TextBlock Text="{DynamicResource 'Performance'}" FontSize="16" FontWeight="SemiBold"/><TextBlock x:Name="Rate" Margin="0,10,0,1" FontSize="23" Foreground="#D9DDE6" FontWeight="Light"/>
<WrapPanel><RadioButton x:Name="Low" Content="{DynamicResource 'Eco'}" GroupName="Perf"/><RadioButton x:Name="Mid" Content="{DynamicResource 'Balanced'}" GroupName="Perf"/><RadioButton x:Name="High" Content="{DynamicResource 'Smooth'}" GroupName="Perf"/><RadioButton x:Name="Ultra" Content="60 FPS" GroupName="Perf"/></WrapPanel>
<TextBlock Text="{DynamicResource 'Rendering stops when the effect ends.'}" Foreground="#B5B9C1" Margin="0,14,0,0" FontSize="12" TextWrapping="Wrap"/></StackPanel></Border></Grid>
<Grid Grid.Row="5" Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="Feedback" TextWrapping="Wrap" Foreground="#C5C9D0" FontSize="12" Margin="0,0,10,0" AutomationProperties.LiveSetting="Polite"/><Button Grid.Column="1" x:Name="Save" Content="{DynamicResource 'Save'}" Margin="0,0,8,0"/><Button Grid.Column="2" x:Name="Apply" Content="{DynamicResource 'Enable effects'}" Foreground="#24272D" Background="#D4DAE4" BorderBrush="#D4DAE4" FontWeight="SemiBold"/></Grid>
</Grid>
<Grid x:Name="VideoView" Grid.Column="1" Visibility="Collapsed" Margin="26,35,26,16">
<Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
<DockPanel><Button x:Name="VideoTarget" DockPanel.Dock="Right" Content="{DynamicResource 'Select display'}" VerticalAlignment="Center" Padding="12,6" AutomationProperties.Name="{DynamicResource 'Video display'}"/><TextBlock Text="{DynamicResource 'Video Cast'}" FontSize="31" FontWeight="SemiBold"/></DockPanel>
<Border Grid.Row="1" Background="#D42B2F36" BorderBrush="#505760" BorderThickness="1" CornerRadius="11" Padding="20" Margin="0,18,0,0">
<StackPanel><TextBlock Text="{DynamicResource 'Video link'}" FontSize="16" FontWeight="SemiBold"/>
<TextBox x:Name="VideoUrl" AutomationProperties.Name="{DynamicResource 'Video link'}" Background="#202328" Foreground="#F1F2F4" CaretBrush="White" BorderBrush="#69717C" BorderThickness="1" Padding="10,9" Margin="0,10,0,6" FontSize="14" VerticalContentAlignment="Center" MaxLength="8192"/>
<TextBlock Text="{DynamicResource 'Paste a Bilibili link or a direct MP4, WebM or M4V URL. Press Enter to cast.'}" Foreground="#B5BBC4" TextWrapping="Wrap" FontSize="12"/>
<StackPanel Orientation="Horizontal" Margin="0,14,0,0"><CheckBox x:Name="FillVideo" Content="{DynamicResource 'Fill screen (crop edges)'}" IsChecked="True" Foreground="#D3DAE4" VerticalContentAlignment="Center"/><CheckBox x:Name="MuteVideo" Content="{DynamicResource 'Mute'}" IsChecked="True" Foreground="#D3DAE4" Margin="14,0,0,0" VerticalContentAlignment="Center"/></StackPanel>
<StackPanel Orientation="Horizontal" Margin="0,20,0,0"><Button x:Name="StartVideo" Content="{DynamicResource 'Cast video'}" Foreground="#24272D" Background="#D4DAE4" BorderBrush="#D4DAE4" FontWeight="SemiBold"/><Button x:Name="PauseVideo" Content="{DynamicResource 'Pause'}" Margin="9,0,0,0" IsEnabled="False"/><Button x:Name="StopVideo" Content="{DynamicResource 'Stop'}" Margin="9,0,0,0" IsEnabled="False"/></StackPanel>
<TextBlock x:Name="VideoStatus" Text="{DynamicResource 'Ready to cast'}" Margin="0,16,0,0" Foreground="#C4CDD9" AutomationProperties.LiveSetting="Polite" TextWrapping="Wrap"/></StackPanel></Border></Grid>
<Grid x:Name="SettingsView" Grid.Column="1" Visibility="Collapsed" Margin="26,35,26,16">
<Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
<DockPanel><Button x:Name="BackToEffect" Content="{DynamicResource 'Back to effects'}" DockPanel.Dock="Right" VerticalAlignment="Center" Padding="12,6"/><TextBlock Text="{DynamicResource 'Settings'}" FontSize="31" FontWeight="SemiBold"/></DockPanel>
<Grid Grid.Row="1" Margin="0,20,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="292"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<StackPanel Grid.Column="2" VerticalAlignment="Top">
<Border Padding="16" Margin="0,0,0,12" Background="#D42B2F36" BorderBrush="#505760" BorderThickness="1" CornerRadius="11"><StackPanel>
<TextBlock Text="{DynamicResource 'Language'}" FontWeight="SemiBold" FontSize="14"/>
<WrapPanel Margin="0,9,0,0">
<RadioButton x:Name="LangEnglish" Content="English" GroupName="Language" Style="{StaticResource CrackChoice}"/>
<RadioButton x:Name="LangChinese" Content="简体中文" GroupName="Language" Style="{StaticResource CrackChoice}"/>
</WrapPanel></StackPanel></Border>
<Border Padding="16" Background="#D42B2F36" BorderBrush="#505760" BorderThickness="1" CornerRadius="11">
<StackPanel><CheckBox x:Name="WallpaperSupport" Content="{DynamicResource 'Use third-party wallpapers'}" Foreground="#EFF2F7" FontWeight="SemiBold" FontSize="14" VerticalContentAlignment="Center"/>
<TextBlock x:Name="WallpaperSupportState" Margin="0,10,0,0" Foreground="#BCC4CE" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/></StackPanel></Border>
<Border Padding="16" Margin="0,12,0,0" Background="#D42B2F36" BorderBrush="#505760" BorderThickness="1" CornerRadius="11"><StackPanel>
<DockPanel><TextBlock x:Name="VersionLabel" DockPanel.Dock="Right" Foreground="#BCC4CE"/><TextBlock Text="{DynamicResource 'Updates'}" FontWeight="SemiBold" FontSize="14"/></DockPanel>
<TextBlock x:Name="UpdateStatus" Margin="0,8,0,10" Foreground="#BCC4CE" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
<WrapPanel><Button x:Name="CheckUpdate" Content="{DynamicResource 'Check now'}" Padding="10,5"/>
<Button x:Name="InstallUpdate" Content="{DynamicResource 'Update and restart'}" Margin="6,0,0,0" Padding="10,5" Visibility="Collapsed"/></WrapPanel>
</StackPanel></Border></StackPanel>
<Border Grid.Column="0" HorizontalAlignment="Left" Width="292" Padding="22" Background="#D42B2F36" BorderBrush="#505760" BorderThickness="1" CornerRadius="11">
<StackPanel><TextBlock Text="{DynamicResource 'Support hahhub'}" FontSize="18" FontWeight="SemiBold"/>
<TextBlock Text="{DynamicResource 'Scan with WeChat to support HAHHAN.'}" Foreground="#BBC2CC" Margin="0,6,0,16" FontSize="13"/>
<Image x:Name="DonationCode" Width="225" Height="225" HorizontalAlignment="Center" RenderOptions.BitmapScalingMode="NearestNeighbor" AutomationProperties.Name="{DynamicResource 'WeChat donation QR code for HAHHAN'}"/></StackPanel>
</Border></Grid></Grid>
</Grid></Window>
